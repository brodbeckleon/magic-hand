{
  // core/ is pure TypeScript: no DOM, no Node. The missing libs make any use of
  // window/document/fetch a compile error, which keeps the gesture logic replayable.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["."],
  "exclude": ["**/*.test.ts"]
}
